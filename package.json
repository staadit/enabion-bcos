{
  "name": "enabion-bcos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@8.15.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "next": "14.2.3"
  },
  "scripts": {
    "dev": "pnpm --filter @enabion/web dev",
    "build": "pnpm db:generate && pnpm db:migrate && pnpm --filter @enabion/web build",
    "start": "pnpm --filter @enabion/web start",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "db:generate": "pnpm --filter @enabion/core db:generate",
    "db:migrate": "pnpm --filter @enabion/core db:migrate",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "cross-env": "^7.0.3",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.2.5",
    "typescript": "5.3.3"
  }
}
