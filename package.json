{
  "name": "enabion-bcos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @enabion/web dev",
    "build": "pnpm --filter @enabion/web build",
    "start": "pnpm --filter @enabion/web start",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "db:generate": "pnpm --filter @enabion/core db:generate",
    "db:migrate": "pnpm --filter @enabion/core db:migrate",
    "postinstall": "PRISMA_CLIENT_ENGINE_TYPE=binary pnpm --filter @enabion/core exec prisma generate --schema packages/core/prisma/schema.prisma"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.2.5",
    "typescript": "5.3.3"
  }
}
