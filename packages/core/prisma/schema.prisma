generator client {
  provider = "prisma-client-js"
  engineType = "dataproxy"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  org_roles        String[]
  default_language String   @default("en")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}
